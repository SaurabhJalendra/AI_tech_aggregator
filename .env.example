# Database
DATABASE_URL=postgresql+asyncpg://advisor:advisor_dev_password@localhost:5433/ai_advisor
DATABASE_URL_SYNC=postgresql://advisor:advisor_dev_password@localhost:5433/ai_advisor

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic — set your API key and USE_CLAUDE_CODE=false to use the SDK
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
USE_CLAUDE_CODE=false

# OpenAI (optional — used for vector search embeddings, falls back to text search if empty)
OPENAI_API_KEY=

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here_change_in_production
NEXTAUTH_URL=http://localhost:3000

# Backend
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
