# Database
DATABASE_URL=postgresql+asyncpg://advisor:advisor_dev_password@localhost:5433/ai_advisor
DATABASE_URL_SYNC=postgresql://advisor:advisor_dev_password@localhost:5433/ai_advisor

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic — set your API key and USE_CLAUDE_CODE=false to use the SDK
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
USE_CLAUDE_CODE=false

# Embeddings — local BAAI/bge-large-en-v1.5 (sentence-transformers); no API key required
EMBEDDINGS_ENABLED=true

# OpenAI (optional legacy — not used for embeddings when local BGE is enabled)
OPENAI_API_KEY=

# Semantic intent (optional tuning; requires EMBEDDINGS_ENABLED=true)
SEMANTIC_INTENT_ENABLED=true
SEMANTIC_INTENT_MIN_CONFIDENCE=0.32
SEMANTIC_INTENT_OVERRIDE_CONFIDENCE=0.48
SEMANTIC_INTENT_OVERRIDE_MARGIN=0.05
SEMANTIC_INTENT_CLARIFY_LOW=0.38
SEMANTIC_INTENT_CLARIFY_MARGIN=0.03

# Planner authority (Phase-1): block LLM panel swaps when a playbook is active
PLANNER_AUTHORITY_STRICT=true
LLM_FALLBACK_ENABLED=true

# Planner kill switch: off | shadow | on (rollback / observability)
# off = bypass planner; shadow = run planner but do not intercept; on = normal
PLANNER_MODE=on

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here_change_in_production
NEXTAUTH_URL=http://localhost:3000

# Backend
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development
